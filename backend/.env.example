# WebVerity Environment Configuration Template
# Safe development defaults - do not store secrets here

APP_NAME="WebVerity"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL="sqlite:///./webverity.db"

# CORS configuration (JSON string list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Analyzer Timeouts (in seconds)
DNS_TIMEOUT=3.0
TLS_TIMEOUT=4.0
SCAN_PIPELINE_TIMEOUT=10.0

# Logging
LOG_LEVEL="INFO"
