# WebVerity Environment Configuration Template
# Safe development defaults - do not store secrets here

APP_NAME="WebVerity"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL="sqlite:///./webverity.db"

# CORS configuration (JSON string list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Analyzer Timeouts (in seconds)
DNS_TIMEOUT=3.0
TLS_TIMEOUT=4.0
SCAN_PIPELINE_TIMEOUT=10.0

# Logging
LOG_LEVEL="INFO"

# Phase 3 - Threat Intelligence (optional credentials, never hardcoded)
URLHAUS_AUTH_KEY=
PHISHTANK_API_KEY=
THREAT_INTELLIGENCE_TIMEOUT=8
THREAT_INTELLIGENCE_CACHE_TTL=900
ENABLE_URLHAUS=true
ENABLE_PHISHTANK=true
# Phase 5 - Collaborative threat intelligence
# Shared secret bearer token granting ADMIN role. Leave empty in development
# (review endpoints stay 403 for anonymous callers). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBVERITY_ADMIN_TOKEN=
# Community submissions per identity per hour (fixed-window rate limit)
SUBMISSION_RATE_LIMIT=5
# Days an approved community indicator stays in the verified table (TTL expiry)
COMMUNITY_INTEL_TTL_DAYS=90
